---
const { title, img, desc, url, badge, tags, target = "_self", button } = Astro.props;
import { Image } from "astro:assets";
const modalId = `modal_${title.toLowerCase().replace(/\s+/g, "_")}`;
---

<div class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%] p-4">
  <div class="hero-content flex-col md:flex-row">
    <a href={url} target={target} class="flex flex-col md:flex-row w-full no-underline">
      {img && (
        <Image
          src={img}
          width={750}
          height={422}
          format="png"
          alt={title}
          class="max-w-full md:max-w-[13rem] rounded-lg"
        />
      )}
      <div class="grow w-full relative md:ml-4">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <p class="py-1 text-1xl">{desc}</p>
      </div>
    </a>

    {button && (
      <button
        class="btn mt-4 w-full md:w-auto"
        onclick={`document.getElementById('${modalId}').showModal()`}
      >
        {button}
      </button>
    )}
  </div>

  {button && (
  <dialog id={modalId} class="modal">
    <div class="modal-box w-11/12 max-w-5xl">
      <h3 class="text-lg font-bold">{title}</h3>
      <p class="py-4">{desc}</p>

      {title === "Math Master" && (
        <video controls class="w-full rounded-lg mt-4">
          <source src="/mathMaster.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      )}

      {title === "Sigua Sarri-Sari Store" && (
        <video controls class="w-full rounded-lg mt-4">
          <source src="/sigua_store.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      )}

      {title === "Recipe Share" && (
        <video controls class="w-full rounded-lg mt-4">
          <source src="/recipeshare.mkv" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      )}

      {title === "TriviasTer" && (
        <video controls class="w-full rounded-lg mt-4">
          <source src="/triviaster.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      )}

      {title !== "Math Master" && title !== "Sigua Sarri-Sari Store" && title !== "TriviasTer" && title !== "Recipe Share" && (
        <p class="text-center text-gray-500 mt-4">There is no video yet. Try to view other project</p>
      )}

      <div class="modal-action">
        <form method="dialog">
          <button class="btn">Close</button>
        </form>
      </div>
    </div>
  </dialog>
)}

</div>
