  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Certifications</div>
  </div>


  <ul class="list-disc mx-6 mb-10 grid gap-2">
  <li>
    <button
      type="button"
      class="text-blue-600 underline hover:text-blue-800 transition"
      onclick="my_modal_3.showModal()"
    >
      Wadhwani - (Employability Skills - Job Ready) -September 07, 2024
    </button>
  </li>
</ul>

<dialog id="my_modal_3" class="modal">
  <div class="modal-box max-w-3xl w-full">
    <form method="dialog">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
    </form>
    <h3 class="text-lg font-bold mb-2">Wadhwani Certification</h3>
    <p class="py-2">Employability Skills - Job Ready<br/>Issued: September 07, 2024</p>
    <div class="w-full h-[500px] mt-4">
      <iframe
        src="/Wadhwani%20Foundation%20Certificate.pdf"
        class="w-full h-full rounded border"
        frameborder="0"
        allowfullscreen
      ></iframe>
    </div>
    <p class="text-xs text-gray-500 mt-2">If the PDF does not display, <a href="/Wadhwani%20Foundation%20Certificate.pdf" target="_blank" class="underline text-blue-600">click here to open it in a new tab</a>.</p>
  </div>
</dialog>



  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Programming languages, 
tools and framework</div>
  </div>

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 mx-6 mb-10">    <div class="flex gap-2 mb-2">
      <SiDart size={25}/> {/* Dart icon */}
      <span class="text-lg">Dart</span>
    </div>
    <div class="flex gap-2 mb-2">
      <SiFlutter size={25}/> {/* Flutter icon */}
      <span class="text-lg">Flutter</span>
    </div>
    <div class="flex gap-2 mb-2">
      <SiJavascript  size={25}/> {/* Flutter icon */}
      <span class="text-lg">Javascript</span>
    </div>

    <div class="flex gap-2 mb-2">
      <RiNextjsFill size={25}/> {/* Flutter icon */}
      <span class="text-lg">next.Js</span>
    </div>

    <div class="flex gap-2 mb-2">
      <SiPhp size={25}/> {/* Flutter icon */}
      <span class="text-lg">PHP</span>
    </div>

    <div class="flex gap-2 mb-2">
      <SiPhpmyadmin size={25}/> {/* Flutter icon */}
      <span class="text-lg">PHPmyadmin</span>
    </div>

    <div class="flex gap-2 mb-2">
      <SiMysql  size={25}/> {/* Flutter icon */}
      <span class="text-lg">MySQL</span>
    </div>

    <div class="flex gap-2 mb-2">
      <SiPython   size={25}/> {/* Flutter icon */}
      <span class="text-lg">Python</span>
    </div>

    <div class="flex gap-2 mb-2">
      <SiReactbootstrap    size={25}/> {/* Flutter icon */}
      <span class="text-lg">React Bootstrap</span>
    </div>

    <div class="flex gap-2 mb-2">
      <SiBootstrap     size={25}/> {/* Flutter icon */}
      <span class="text-lg">Bootstrap</span>
    </div>

    <div class="flex gap-2 mb-2">
      <SiTailwindcss size={25}/> {/* Flutter icon */}
      <span class="text-lg">tailwind</span>
    </div>

    <div class="flex gap-2 mb-2">
      <SiHtml5 size={25}/> {/* Flutter icon */}
      <span class="text-lg">HTML</span>
    </div>

    <div class="flex gap-2 mb-2">
      <SiCss3 size={25}/> {/* Flutter icon */}
      <span class="text-lg">CSS</span>
    </div>

    <div class="flex gap-2 mb-2">
      <VscVscode size={25}/> {/* Flutter icon */}
      <span class="text-lg">Vs code</span>
    </div>

    <div class="flex gap-2 mb-2">
      <RiGithubFill size={25}/> {/* Flutter icon */}
      <span class="text-lg">Github</span>
    </div>

  </div>



  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Core work skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>Critical Thinking</li>
    <li>Problem Solving</li>
    <li>Teamwork & Collaboration</li>
    <li>Leadership</li>
    <li>Good Communication</li>
  </ul>

</BaseLayout>
