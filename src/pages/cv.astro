---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import { SiFlutter,SiDart, SiJavascript, SiPhp, SiPhpmyadmin, SiMysql,
   SiPython, SiReactbootstrap,SiBootstrap,SiTailwindcss, SiHtml5, SiCss3} from "react-icons/si";
import { RiNextjsFill, RiGithubFill } from "react-icons/ri";
import { VscVscode } from "react-icons/vsc";




---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Profile</div>
  </div>

  <div class="mb-10 text-justify">
I am an Information Technology graduate with a specialization in web development and hands-on experience in building dynamic websites, mobile applications, and end-to-end systems. I have developed web applications using modern frameworks and tools such as Next.js, React-Bootstrap, Tailwind CSS, and CSS, and I have built cross-platform mobile apps using Flutter, Dart. On the backend, I’m proficient in PHP, JavaScript, and MySQL, enabling me to create robust and scalable systems. I also have foundational knowledge in network and system troubleshooting, allowing me to approach development with a well-rounded technical perspective. I’m eager to apply my skills and creativity to real-world challenges and contribute meaningfully to innovative, impactful projects.
  
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
    
      title="Graduated"
      subtitle="[2021] to [2025] at [Phinma-Cagayan De Oro College], [Cagayan De Oro], [Philippines]"
    />

  </div>

   <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>
  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
    
      title="REMOTASKS | APRIL 2024 - MAY 2025"
      subtitle="I worked at Remotasks for a year, and during that time, I learned a lot about Image Annotation and LiDAR Annotation. I also developed the ability to quickly adapt to new projects."
    />
    <TimeLineElement
    
      title="CLIMBS Life and General Insurance Cooperative | December 9, 2024 - MARCH 19, 2025"
      subtitle="I worked at CLIMBS Life and General Insurance Cooperative as a Data Entry intern. However, my role involved more than just data entry I also troubleshooted my own computer issues and updated the CIIMS on my computer"
    />

  </div>

