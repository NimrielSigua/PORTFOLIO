               <code class="language-TS">
    const handleUpdate = async (e: React.FormEvent) =&gt; &#123;
      e.preventDefault(); // Prevent form from reloading the page

      try &#123;
        // Send a PUT request to update the user's data
        const res = await fetch(`/api/users/$&#123;id&#125;`, &#123;
          method: "PUT", // HTTP method
          headers: &#123;
            "Content-Type": "application/json", // Sending JSON data
          &#125;,
          // Request body includes updated user data
          body: JSON.stringify(&#123; firstname, middlename, lastname &#125;),
        &#125;);

        // If request was successful, alert the user and redirect to home page
        if (res.ok) &#123;
          alert("User updated successfully!");
          router.push("/"); // Navigate to homepage
        &#125; else &#123;
          // If request failed, show an error alert
          alert("Failed to update user.");
        &#125;
      &#125; catch (err) &#123;
        // Catch and log any network or server errors
        console.error("Update error:", err);
        alert("An error occurred.");
      &#125;
    &#125;;
