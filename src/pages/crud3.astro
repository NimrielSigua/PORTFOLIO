               <code class="language-TS">
    // Import the main mongoose object and the Schema constructor from the mongoose package
    import mongoose, &#123; Schema &#125; from 'mongoose';
                
    // Define the structure (schema) of the "Users" collection in the database
    const userSchema = new Schema(&#123;
      // 'firstname' is a required string field
      firstname: &#123; type: String, required: true &#125;,
                
      // 'middlename' is an optional string field
      middlename: &#123; type: String &#125;,
                
      // 'lastname' is a required string field
      lastname: &#123; type: String, required: true &#125;,
    &#125;);
                
    // Create a model called 'Users' from the userSchema
    // If the model already exists in the mongoose models cache, reuse it (important for development to avoid overwrite errors)
    // Otherwise, create a new model named 'Users' using the schema
    const Users = mongoose.models.Users || mongoose.model('Users', userSchema);
                
    // Export the Users model so it can be used in other parts of the app (e.g. for inserting/finding users)
    export default Users;
        </code>
