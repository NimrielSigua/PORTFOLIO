               <code class="language-TS">
const submitUsers = async (e: React.FormEvent&lt;HTMLFormElement&gt;) =&gt; &#123;
  e.preventDefault(); // Prevent page reload on form submission

  try &#123;
    // Send a POST request to your backend API route
    const res = await fetch("http://localhost:3000/api/users/", &#123;
      method: "POST",
      headers: &#123;
        "Content-Type": "application/json", // Tell the server you're sending JSON
      &#125;,
      // Convert state values into JSON to send to the server
      body: JSON.stringify(&#123; firstname: fname, middlename: mname, lastname: lname &#125;),
    &#125;);

    if (res.ok) &#123;
      const data = await res.json(); // Parse the JSON response from the server

      setTimeout(() =&gt; &#123;
        // Here you're checking a 'role' field, but this might not exist in the response
        // You can change this to check data.message or just alert success
        alert("User inserted successfully!");
      &#125;, 1500);
    &#125; else &#123;
      const errorData = await res.json();
      console.error("Server error:", errorData);
      alert("Failed to insert user.");
    &#125;
  &#125; catch (error) &#123;
    console.error("Submission error:", error); // Catch network or code errors
    alert("Error occurred while submitting the form.");
  &#125;
&#125;;

