                    >
                        <pre
                            class="whitespace-pre text-sm">
               <code class="language-TS">
// Fetch the user's current data when the component loads or when the `id` changes
useEffect(() =&gt; &#123;
  const fetchUser = async () =&gt; &#123;
    // Send a GET request to your API to fetch the user by ID
    const res = await fetch(`http://localhost:3000/api/users/$&#123;id&#125;`);
    const data = await res.json(); // Parse JSON response

    // Support for both single user object (`user`) or list (`users`)
    const user = data.user || data.users?.[0];

    // If user data exists, populate the state fields
    if (user) &#123;
      setFirstname(user.firstname);              // Set first name
      setMiddlename(user.middlename || "");      // Set middle name (or empty string if null)
      setLastname(user.lastname);                // Set last name
    &#125;
  &#125;;

  // Run fetchUser only if `id` exists
  if (id) fetchUser();
&#125;, [id]); // Dependency array: re-run this effect when `id` changes

