---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="learn Code" sideBarActiveItemID="sources">
  <div>
    <div class="text-3xl w-full font-bold mb-2">Learn Code</div>
  </div>

  <HorizontalCard
    title="CRUD HTML | JS | PHP with jQuery"
    img="/crud.png"
    desc="Learn how to create, read, update and delete data in a database"
    url="/crud1"
  />

  <HorizontalCard
    title="Register & Login HTML | JS | PHP"
    img="/register_login.png"
    desc="Learn how to create a register and login system using HTML, JS, and PHP"
    url="/register_login"
  />

</BaseLayout>