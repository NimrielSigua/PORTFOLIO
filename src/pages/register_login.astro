    >
      <div class="mx-auto max-w-5xl w-full">
        <h1 class="text-center text-3xl font-bold border-b-4">LOGIN</h1>

        <!-- CONNECTION Section -->
        <div class="mt-5">
          <h1 class="font-bold text-2xl">CONNECTION</h1>
          <p>
            To connect to a MySQL database called <code>registerlogin_db</code> hosted
            on
            <code>localhost</code> using the username <code>root</code> and no password.
            If the connection fails, it displays an error message.
          </p>

          <div
            class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
          >
            <pre
              class="whitespace-pre text-sm">
               <code class="language-php">
  &lt;?php
      $servername = "localhost";
      $dbusername = "root";
      $dbpassword = "";
      $dbname = "database_name";

      try &#123;
          $conn = new PDO("mysql:host=$servername;dbname=$dbname", $dbusername, $dbpassword);
          $conn->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

      &#125; catch(PDOException $e) &#123;
          echo "Connection failed: " . $e->getMessage();
          die;  
      &#125;
  ?&gt;
                </code>
            </pre>
          </div>
        </div>
        <!-- END CONNECTION Section -->


        <div class="mt-16">
          <h1 class="font-bold text-2xl">loginUser</h1>
          <p>
            This function handles user login by checking the provided email and password against the records in the <code>users</code> table in the database.
            It returns 1 if the login is successful, otherwise it returns 0.
          </p>

          <div
            class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
          >
            <pre
              class="whitespace-pre text-sm">
               <code class="language-php">
    function userLogin($json) &#123;
    // Include the database connection script to use the $conn variable
    include "connection.php";

    // Decode the incoming JSON string into an associative array
    $json = json_decode($json, true);

    // Extract the 'email' from the decoded JSON array
    $email = $json["email"];

    // Extract the 'password' from the decoded JSON array
    $password = $json["password"];

    // Prepare an SQL query to find a user matching the given email and password
    $sql = "SELECT user_id, email FROM user WHERE email = :email AND password = :password";

    // Prepare the SQL statement for execution
    $stmt = $conn->prepare($sql);

    // Bind the email value to the :email placeholder in the SQL statement
    $stmt->bindParam(':email', $email);

    // Bind the password value to the :password placeholder in the SQL statement
    $stmt->bindParam(':password', $password);

    // Execute the prepared statement
    $stmt->execute();

    // Fetch the resulting row as an associative array (if any)
    $user = $stmt->fetch(PDO::FETCH_ASSOC);

    // If a user is found, return their user_id and email as a JSON-encoded array
    if ($user) &#123;
        return json_encode(['user_id' => $user['user_id'], 'email' => $user['email']]);
    &#125; else &#123;
        // If no user was found, return an empty JSON array
        return json_encode([]);
    &#125;
    &#125;

                </code>
            </pre>
          </div>
        </div>
        <!-- END registerUser Section -->

        <div class="mt-16">
          <h1 class="font-bold text-2xl">API Endpoint Handler</h1>
          <p>
            To route requests to the appropriate method of the User class based on what the client wants to do Register a user.
          </p>

          <div
            class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
          >
            <pre
              class="whitespace-pre text-sm">
               <code class="language-php">
    $json = isset($_POST['data']) ? $_POST['data'] : '';
        $operation = $_POST['operation'];

        $user = new Users();

        switch($operation)&#123;
            case 'userLogin':
                  echo $user->userLogin($json);
                  break;
    &#125;

                </code>
            </pre>
          </div>
        </div>
        <!-- END API Endpoint Handler Section -->

        <div class="mt-16">
          <h1 class="font-bold text-2xl">JS loginUser</h1>
          <p>
            This JavaScript function handles the login process by sending a POST request to the server with the user's email and password.
            It uses Axios for making HTTP requests and handles the response accordingly.
          </p>

          <div
            class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
          >
            <pre
              class="whitespace-pre text-sm">
               <code class="language-JS">
    const serverapi = async () => "http://localhost/File_Path.php";

    
    const loginUser = async (event) => &#123;
    event.preventDefault();

    const url = await serverapi();

    const jsonData = &#123;
        email: document.getElementById('email-login').value,
        password: document.getElementById('password-login').value,
    &#125;

    const formData = new FormData();
    formData.append('data', JSON.stringify(jsonData));
    formData.append('operation', 'userLogin');

     try 
        const response = await axios.post(url, formData);

        if (response.data.user_id) &#123;
            window.location.href = "home.html";
        &#125; else &#123;
            alert("Login Failed, Wrong Username or Password");
            console.log(response);
        &#125;
    &#125; catch (error) &#123;
        console.error(error);
        alert("An error occurred during login");
    &#125;
&#125;

    $('#loginForm').on('submit', loginUser);

                </code>
            </pre>
          </div>
        </div>
        <!-- END JS loginUser Section -->

