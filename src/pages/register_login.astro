        <div class="mt-16">
          <h1 class="font-bold text-2xl">registerUser</h1>
          <p>
            This function handles user registration by inserting the provided
            email and password into the <code>users</code> table in the database.
          </p>

          <div
            class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
          >
            <pre
              class="whitespace-pre text-sm">
               <code class="language-php">
    function userRegister($json) &#123;
        // Include the database connection file to access the $conn object
        include "connection.php";
                  
        // Decode the JSON string into an associative array
        $json = json_decode($json, true);
                  
        // Extract the 'email' field from the decoded array
        $email = $json["email"];
                  
        // Extract the 'password' field from the decoded array
        $password = $json["password"];
                  
        // Prepare an SQL INSERT query with named placeholders for binding parameters
        $sql = "INSERT INTO user (email, password) VALUES (:email, :password)";
                  
        // Prepare the SQL statement for execution
        $stmt = $conn->prepare($sql);
                  
        // Bind the email value to the :email placeholder in the SQL query
        $stmt->bindParam(':email', $email);
                  
        // Bind the password value to the :password placeholder in the SQL query
        $stmt->bindParam(':password', $password);
                  
        // Execute the prepared SQL statement
        $stmt->execute();
                  
        // Check if any rows were inserted; return 1 if successful, 0 otherwise
        $returnValue = $stmt->rowCount() > 0 ? 1 : 0;
                  
        // Return the result of the registration attempt
        return $returnValue;
    &#125;

                </code>
            </pre>
          </div>
        </div>
        <!-- END registerUser Section -->

        <div class="mt-16">
