        <div class="mt-16">
          <h1 class="font-bold text-2xl">JS registerUser</h1>
          <p>
            This JavaScript function handles the registration process by sending a POST request to the server with the user's email and password.
            It uses Axios for making HTTP requests and handles the response accordingly.
          </p>

          <div
            class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
          >
            <pre
              class="whitespace-pre text-sm">
               <code class="language-JS">
    const serverapi = async () => "http://localhost/File_Path.php";

    
    const registerUser = async (event) => &#123;
        event.preventDefault();

        const url = await serverapi();

        const jsonData = &#123;
            email: document.getElementById('email').value,
            password: document.getElementById('password-register').value,
        &#125;;

        const formData = new FormData();
        formData.append('data', JSON.stringify(jsonData));
        formData.append('operation', 'userRegister');

        axios.post(url, formData)
            .then(response => &#123;
                if (response.data == 1)&#123;
                    alert ("Registration successful!");
                    document.getElementById("register-user").reset();
                    document.querySelector('[data-modal-hide="register-modal"]').click();
                &#125; else &#123;
                    alert("Registration failed. Please try again.");
                &#125;
            &#125;).catch(err => alert(err));
    &#125;

    $('#register-user').on('submit', registerUser);

                </code>
            </pre>
          </div>
        </div>
        <!-- END JS registerUser Section -->

