                    <h1 class="font-bold text-2xl mt-5">fetchUser</h1>
                    <p class="mt-2" >
                       To fetch a list of users from a PHP backend and store that list in the component's users state so it can be displayed or used in the UI.
                    </p>
                    <div
                        class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
                    >
                        <pre
                            class="whitespace-pre text-sm">
               <code class="language-TS">
// Define an asynchronous function to fetch user data from the server
const fetchUser = async () =&gt; &#123;
  try &#123;
    // Make a POST request to the PHP backend endpoint
    const response = await fetch('http://localhost/File_Path', &#123;
      method: 'POST', // Specify HTTP method as POST
      headers: &#123;
        'Content-Type': 'application/json', // Set the request header to send JSON
      &#125;,
      // Send a JSON body with an 'operation' key to instruct the backend what to do
      body: JSON.stringify(&#123; operation: 'getUsers' &#125;),
    &#125;);

    // If the response is not successful (status code is not in the 200 range), throw an error
    if (!response.ok) &#123;
      throw new Error(`HTTP error! status: &#36;&#123;response.status&#125;`);
    &#125;

    // Parse the response body as JSON
    const data = await response.json();

    // Update the state variable `users` with the fetched data
    setUsers(data);
  &#125; catch (error) &#123;
    // If an error occurs (network error, JSON parse error, etc.), log it to the console
    console.error('Error fetching customers:', error);
  &#125;
&#125;;
                </code>
            </pre>
                    </div>

                    <h1 class="font-bold text-2xl mt-5">useEffect</h1>
                    <p class="mt-2" >
                      The useEffect hook with an empty dependency array runs the <code>fetchUser()</code>  function once when the component first mounts, ensuring the user data is loaded when the page loads.
                    </p>
                    <div
                        class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
                    >
                        <pre
                            class="whitespace-pre text-sm">
               <code class="language-TS">
    useEffect(() => &#123;
    fetchUser();
  &#125;, []);
                </code>
            </pre>
                    </div>

