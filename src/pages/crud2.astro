    &#125;
    class Users &#123;

        //addUsers

        //getUsers

        //updateUsers

        //deleteUsers

    &#125;

    //Operation Handler

    //switch-case control structure


    ?&gt;
                </code>
            </pre>
                    </div>
                    

                    <h1 class="font-bold text-2xl mt-5">addUsers</h1>
                    <p class="mt-2" >
                       The purpose of the addUsers function is to insert a new user’s first name, middle name, and last name into the database and return a success status in JSON format.
                    </p>
                    <div
                        class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
                    >
                        <pre
                            class="whitespace-pre text-sm">
               <code class="language-TS">
    function addUsers($json) &#123;
    include 'connection.php';
    $data = is_array($json) ? $json : json_decode($json, true);

    $fname = $data['fname'];
    $mname = $data['mname'];
    $lname = $data['lname'];

    $sql = "INSERT INTO users (firstname, middlename, lastname) VALUES (:fname, :mname, :lname)";
    $stmt = $conn->prepare($sql);
    $stmt->bindParam(':fname', $fname);
    $stmt->bindParam(':mname', $mname);
    $stmt->bindParam(':lname', $lname);
    $stmt->execute();
    $returnValue = $stmt->rowCount() > 0 ? 1 : 0;
    unset($conn);
    unset($stmt);
    return json_encode($returnValue);
&#125;

                </code>
            </pre>
                    </div>

                    <h1 class="font-bold text-2xl mt-5">getUsers</h1>
                    <p class="mt-2" >
                       The purpose of the `getUsers` function is to retrieve all user records from the `users` table in the database and return them as a JSON-encoded array.
                    </p>
                    <div
                        class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
                    >
                        <pre
                            class="whitespace-pre text-sm">
               <code class="language-TS">
  function getUsers()&#123;
    include 'connection.php';

    $sql = "SELECT * FROM users";
    $stmt = $conn->prepare($sql);
    $stmt->execute();
    $users = $stmt->fetchAll(PDO::FETCH_ASSOC);
    unset($conn);
    unset($stmt);   
    return json_encode($users);
&#125;
            </code>
            </pre>
                    </div>

                    <h1 class="font-bold text-2xl mt-5">updateUsers</h1>
                    <p class="mt-2" >
                      The updateUsers function updates a user's first name, middle name, and last name in the database based on their ID, and returns 1 if successful, otherwise 0.
                    </p>
                    <div
                        class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
                    >
                        <pre
                            class="whitespace-pre text-sm">
               <code class="language-TS">
function updateUsers($json)&#123;
    include 'connection.php';

    $data = is_array($json) ? $json : json_decode($json, true);
    $id = $data['id'];
    $fname = $data['fname'];
    $mname = $data['mname'];
    $lname = $data['lname'];

    $sql = "UPDATE users SET firstname = :fname, middlename = :mname, lastname = :lname WHERE id = :id";
    $stmt = $conn->prepare($sql);
    $stmt->bindParam(':id', $id);
    $stmt->bindParam(':fname', $fname);
    $stmt->bindParam(':mname', $mname);   
    $stmt->bindParam(':lname', $lname);
    $stmt->execute();
    $returnValue = $stmt->rowCount() > 0 ? 1 : 0;
    unset($conn);
    unset($stmt);
    return json_encode($returnValue);
&#125;
                </code>
            </pre>
                    </div>

                    <h1 class="font-bold text-2xl mt-5">deleteUsers</h1>
                    <p class="mt-2" >
                      The deleteUsers function deletes a user from the database based on the given user ID and returns 1 if the deletion was successful, otherwise 0.
                    </p>
                    <div
                        class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
                    >
                        <pre
                            class="whitespace-pre text-sm">
               <code class="language-TS">
function deleteUsers($json)&#123;
    include 'connection.php';

    $data = is_array($json) ? $json : json_decode($json, true);

    $id = $data['id'];

    $sql = "DELETE FROM users WHERE id = :id";
    $stmt = $conn->prepare($sql);
    $stmt->bindParam(':id', $id);
    $stmt->execute();
    $erturnValue = $stmt->rowCount() > 0 ? 1 : 0;

    unset($conn);
    unset($stmt);
    return json_encode($erturnValue);
&#125;

                </code>
            </pre>
                    </div>

                    <h1 class="font-bold text-2xl mt-5">Operation Handler</h1>
                    <p class="mt-2" >
                     This code snippet handles incoming API requests and supports different formats (like JSON in the body or standard POST/GET form data). It determines what operation to perform (like addUsers, deleteUsers, etc.) and retrieves the associated data.
                    </p>
                    <div
                        class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
                    >
                        <pre
                            class="whitespace-pre text-sm">
               <code class="language-TS">
    // Support both JSON and form-data requests
$operation = null;
$json = null;

$input = json_decode(file_get_contents('php://input'), true);
if ($input && isset($input['operation'])) &#123;
    $operation = $input['operation'];
    $json = isset($input['json']) ? $input['json'] : null;
&#125; else if ($_SERVER['REQUEST_METHOD'] === 'POST') &#123;
    $operation = isset($_POST['operation']) ? $_POST['operation'] : null;
    $json = isset($_POST['json']) ? $_POST['json'] : null;
&#125; else if ($_SERVER['REQUEST_METHOD'] === 'GET') &#123;
    $operation = isset($_GET['operation']) ? $_GET['operation'] : null;
    $json = isset($_GET['json']) ? $_GET['json'] : null;
&#125;

                </code>
            </pre>
                    </div>

                    <h1 class="font-bold text-2xl mt-5">switch-case control structure</h1>
                    <p class="mt-2" >
                     This block executes the corresponding method from the Users class based on the given $operation (like addUsers, getUsers, etc.), allowing the backend to perform the requested action and return a response.
                    </p>
                    <div
                        class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
                    >
                        <pre
                            class="whitespace-pre text-sm">
               <code class="language-TS">
  $users = new Users();
switch ($operation) &#123;
    case 'addUsers':
        echo $users->addUsers($json);
        break;
    case 'getUsers':
        echo $users->getUsers();
        break;
    case 'updateUsers':
        echo $users->updateUsers($json);
        break;
    case 'deleteUsers':
        echo $users->deleteUsers($json);
        break;
    default:
        echo json_encode(['error' => 'Invalid operation']);
        break;
&#125;
                </code>
            </pre>
