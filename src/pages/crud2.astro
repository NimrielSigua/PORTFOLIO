                    <h1 class="font-bold text-2xl mt-5">updateUser</h1>
                    <p class="mt-2" >
                      Update an existing user's information in the database from a React frontend.
                    </p>
                    <div
                        class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
                    >
                        <pre
                            class="whitespace-pre text-sm">
               <code class="language-TS">
// Define an asynchronous function called updateUser that handles form submission or button click
const updateUser = async (e: React.FormEvent | React.MouseEvent) => &#123;
  e.preventDefault(); // Prevent the default form submission or button behavior (e.g., page reload)

  // Prepare the data to be sent to the PHP backend
  const data = &#123;
    operation: 'updateUsers', // Tell the backend which operation to perform (e.g., update user)
    json: &#123; id: editId, fname, mname, lname &#125;, // Pass the user ID and updated names as JSON
  &#125;;

  try &#123;
    // Send a POST request to the PHP backend endpoint
    const response = await fetch('http://localhost/File_Path', &#123;
      method: 'POST', // Use HTTP POST method
      headers: &#123;
        'Content-Type': 'application/json', // Specify content type as JSON
      &#125;,
      body: JSON.stringify(data), // Convert the JavaScript object to a JSON string
    &#125;);

    // Parse the JSON response from the server
    const result = await response.json();

    // If the server response equals 1 (success flag)
    if (result === 1) &#123;
      // Show a success message using SweetAlert
      Swal.fire(&#123;
        title: 'Success!',
        text: 'User updated successfully!',
        icon: 'success',
        confirmButtonText: 'OK'
      &#125;);

      // Clear the form input fields after successful update
      setFname("");
      setMname("");
      setLname("");

      // Reset the edit mode by setting editId to null
      setEditId(null);

      // Refresh the list of users to reflect the updated data
      fetchUser();
    &#125; else &#123;
      // If the response is not 1, show an error message using SweetAlert
      Swal.fire(&#123;
        title: 'Error!',
        text: 'Failed to update user.',
        icon: 'error',
        confirmButtonText: 'OK'
      &#125;);
    &#125;
  &#125; catch (error) &#123;
    // Catch and log any errors during the fetch or processing
    console.error('Error:', error);

    // Show a general error message using SweetAlert
    Swal.fire(&#123;
      title: 'Error!',
      text: 'An error occurred. Please try again.',
      icon: 'error',
      confirmButtonText: 'OK'
    &#125;);
  &#125;
&#125;;

                </code>
            </pre>
                    </div>

                    <h1 class="font-bold text-2xl mt-5">handleDelete</h1>
                    <p class="mt-2" >
                      The purpose of handleDelete is to safely and interactively delete a user record from the backend, while providing user feedback and ensuring the UI stays updated.
                    </p>
                    <div
                        class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
                    >
                        <pre
                            class="whitespace-pre text-sm">
               <code class="language-TS">
// Define an asynchronous function to handle deleting a user
const handleDelete = async (user: any) => &#123;
  
  // Show a confirmation dialog using SweetAlert to confirm deletion
  const confirm = await Swal.fire(&#123;
    title: 'Are you sure?',                 // Dialog title
    text: 'This action cannot be undone!',  // Dialog message
    icon: 'warning',                        // Warning icon
    showCancelButton: true,                 // Include a Cancel button
    confirmButtonText: 'Yes, delete it!',   // Text for the confirm button
  &#125;);

  // Proceed only if the user confirmed the deletion
  if (confirm.isConfirmed) &#123;
    try &#123;
      // Prepare the data to be sent to the PHP backend
      const data = &#123;
        operation: 'deleteUsers',         // Operation type for backend
        json: &#123; id: user.id &#125;,   // Send the ID of the user to be deleted
      &#125;;

      // Send a POST request to the PHP backend to delete the user
      const response = await fetch('http://localhost/File_Path', &#123;
        method: 'POST',                   // HTTP method
        headers: &#123;
          'Content-Type': 'application/json', // Set content type to JSON
        &#125;,
        body: JSON.stringify(data),       // Convert the data object to a JSON string
      &#125;);

      // Parse the JSON response from the backend
      const result = await response.json();

      // If the result is 1 (success indicator), show success message
      if (result === 1) &#123;
        Swal.fire('Deleted!', 'User has been deleted.', 'success'); // Show success alert
        fetchUser(); // Refresh the user list after deletion
      &#125; else &#123;
        // If deletion failed, show an error alert
        Swal.fire('Error!', 'Failed to delete user.', 'error');
      &#125;
    &#125; catch (error) &#123;
      // If there's an error during fetch or processing, log it and show an error alert
      console.error('Error:', error);
      Swal.fire('Error!', 'An error occurred. Please try again.', 'error');
    &#125;
  &#125;
&#125;;

                </code>
            </pre>
                    </div>

                </div>
            </div>
        </div>
