               <code class="language-TS">
// Define an async function named addInfo that handles form or button click events 
const addInfo = async (e: React.FormEvent | React.MouseEvent) =&gt; &#123;
  e.preventDefault(); // Prevent the default form submission behavior

  // Create the data object to be sent to the backend
  const data = &#123;
    operation: 'addUsers', // Specify the operation to perform in PHP
    json: &#123; fname, mname, lname &#125;, // Include user data from input states
  &#125;;

  try &#123;
    // Send the data to the backend using fetch with POST method
    const response = await fetch('http://localhost/File_Path.php', &#123;
      method: 'POST',
      headers: &#123;
        'Content-Type': 'application/json', // Set request header to JSON
      &#125;,
      body: JSON.stringify(data), // Convert data object to JSON string
    &#125;);

    const result = await response.json(); // Parse JSON response from backend

    if (result === 1) &#123;
      // If operation is successful (response is 1), show success alert
      Swal.fire(&#123;
        title: 'Success!',
        text: 'Transaction added successfully!',
        icon: 'success',
        confirmButtonText: 'OK'
      &#125;);

      // Clear the input fields
      setFname("");
      setMname("");
      setLname("");
      fetchUser(); // Refresh the user list after adding

    &#125; else &#123;
      // If operation failed, show error alert
      Swal.fire(&#123;
        title: 'Error!',
        text: 'Failed to add transaction.',
        icon: 'error',
        confirmButtonText: 'OK'
      &#125;);
    &#125;
  &#125; catch (error) &#123;
    // Catch and log any errors during the request
    console.error('Error:', error);
    Swal.fire(&#123;
      title: 'Error!',
      text: 'An error occurred. Please try again.',
      icon: 'error',
      confirmButtonText: 'OK'
    &#125;);
  &#125;
&#125;;

