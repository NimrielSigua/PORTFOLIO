// Define an asynchronous function to fetch user records from the server
const fetchRecords = async () => &#123
    // Get the URL of the server where the PHP backend is hosted
    const url = await getServerUrl();

    // Create a FormData object to hold the data that will be sent to the server
    const formData = new FormData();

    // Append the "operation" value as "getRecords", so the server knows what action to perform
    formData.append("operation", "getRecords");

    try &#123
        // Send a POST request to the server with the form data using Axios
        const response = await axios.post(url, formData);

        // Check if the response contains an array of data (user records)
        if (response.data && Array.isArray(response.data)) &#123
            // If data exists, call the displayRecords function to render it in the table
            displayRecords(response.data);
        &#125 else &#123
            // Show an alert if no data was found or the response is not as expected
            alert("No records found.");
        &#125
    &#125 catch (err) &#123
        // If there's an error while making the request, show an alert to the user
        alert("Failed to fetch records.");
    &#125
&#125;
