<code class="JS">
    const getServerdescriptionUrl = async () => "http://localhost/File_Path.php";


 const saveDescription = async (event) => &#123
        event.preventDefault();
        const url = await getServerdescriptionUrl();

        const userOption = usercategory.options[usercategory.selectedIndex];
        const user_id = userOption.dataset.id;

        const json = &#123
