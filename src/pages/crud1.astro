            description: document.getElementById("description").value,

        &#125;

        console.log(user_id);

        const formData = new FormData();
        formData.append("json", JSON.stringify(json));
        formData.append("operation", "saveDescription");

        axios.post(url, formData)
            .then(response => &#123
