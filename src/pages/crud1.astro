                &lt;form id="addUserForm" class="space-y-4 mt-4"&gt;
                    &lt;div&gt;
                        &lt;label&gt; for="fname" class="block mb-2 text-sm font-medium"&gt;Firstname&lt;/label&gt;
                        &lt;input type="text" id="fname" required class="border border-gray-300 rounded-lg w-full p-2.5" /&gt;
