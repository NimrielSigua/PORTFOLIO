// Define an asynchronous function to delete a user
const deleteUser = async () => &#123
    // Get the server URL using a helper function
    const url = await getServerUrl();

    // Retrieve the user ID stored in the data attribute of the confirmation modal
    const id = $("#popup-modal").data("userid");

    // Create a JSON object with the user ID to be sent to the server
    const json = &#123
        id: id
    &#125;

    // Create a FormData object to package the data
    const formData = new FormData();
    // Add the JSON string containing the user ID
    formData.append("json", JSON.stringify(json));
    // Specify the operation to be performed ("delete")
    formData.append("operation", "delete");

    try &#123
        // Send a POST request to the server using Axios with the form data
        const response = await axios.post(url, formData);

        // Check if the server responded with 1, indicating successful deletion
        if (response.data == 1) &#123
            // Inform the user that the deletion was successful
            alert("User deleted successfully.");
            // Hide the delete confirmation modal
            $("#popup-modal").addClass("hidden");
            // Refresh the user records table
            fetchRecords();
        &#125 else &#123
            // Alert the user if deletion failed and log the response
            alert("Failed to delete user.");
            console.log(response.data);
        &#125
    &#125 catch (err) &#13
        // Catch any errors in the process and show an alert with the error message
        alert("Error deleting user: " + err.message);
    &#125
&#125;
