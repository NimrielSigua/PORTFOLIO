    type="button"&gt;
    Add Data
&lt;/button&gt;
                </code>
            </pre>
          </div>

          <div
            class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
          >
            <pre
              class="whitespace-pre text-sm">
               <code class="html">
&lt;div id="authentication-modal" tabindex="-1" aria-hidden="true"
            class="hidden fixed top-0 right-0 left-0 z-50 flex justify-center items-center w-full h-full bg-black bg-opacity-50"&gt;
            &lt;div class="bg-white p-6 rounded-lg w-full max-w-md"&gt;
                &lt;div class="flex justify-between items-center pb-4 border-b"&gt;
                    &lt;h3&gt; class="text-xl font-semibold"&gt;Add User&lt;/h3&gt;
