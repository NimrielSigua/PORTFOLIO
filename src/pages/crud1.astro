          <code class="language-js">
// Function to save user data when the form is submitted
const saveUser = async (event) => &#123

    // Prevent the default form submission which reloads the page
    event.preventDefault();

    // Get the server URL where the PHP backend is located (assumed async)
    const url = await getServerUrl();

    // Create a JavaScript object containing user inputs from the form fields
    const json = &#123
        fname: document.getElementById("fname").value,  // Get first name input value
        mname: document.getElementById("mname").value,  // Get middle name input value
        lname: document.getElementById("lname").value,  // Get last name input value
    &#125;

    // Create a FormData object to send data like a form submission
    const formData = new FormData();

    // Add the JSON string of the user data to formData with key "json"
    formData.append("json", JSON.stringify(json));

    // Add the operation type to inform the backend which action to perform
    formData.append("operation", "save");

    // Use Axios to send a POST request to the backend with the form data
    axios.post(url, formData)
        .then(response => &#123
            // If the response data is 1, it means the save was successful
            if (response.data == 1) &#123
                alert("User added successfully.");    // Show success message
                
                // Reset the form inputs to empty
                document.getElementById("addUserForm").reset();

                // Programmatically close the modal by clicking the close button
                document.querySelector('[data-modal-hide="authentication-modal"]').click();

                // Refresh the user list or records after successful save
                fetchRecords();
            &#125 else &#123
                // If response is not 1, show an error message
                alert("Failed to add user.");

                // Log the response data to console for debugging
                console.log(response.data);
            &#125
        &#125)
        // Catch any errors (network/server) and alert the user
        .catch(err => alert(err));
&#125;


//When the user submits the form named addUserForm, run the saveUser function.
$("#addUserForm").on("submit", saveUser);

