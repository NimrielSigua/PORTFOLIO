              class="whitespace-pre text-sm">
               <code class="language">
 const getServerUrl = async () => "http://localhost/File_Path.php";

     const usercategory = document.getElementById("category");


 async function populateUserOptions() &#123;
        fetchRecords()
        const url = await getServerUrl();


        const formData = new FormData();
        formData.append("operation", "getRecords");

        try &#123;
            const response = await axios.post(url, formData);
            const data = response.data;

            usercategory.innerHTML = '&lt; option value="" disabled selected&gt; Select User&lt;/option&gt;'; // Clear existing options


            data.forEach(function (record) &#123;
                const optionUser = document.createElement("option");

                optionUser.textContent = record.fname + " " + record.mname + " " + record.lname; // Set option text
                optionUser.value = record.id;
                optionUser.dataset.id = record.id; // Set dataset attribute


                usercategory.appendChild(optionUser);
            &#125;);
        &#125; catch (error) &#123
            console.error(error);
        &#125;
    &#125;

    populateUserOptions();
</code>
