const displayRecords = (data) => &#123

    // If the DataTable already exists on #systemTable, destroy it to avoid duplication
    if ($.fn.DataTable.isDataTable('#systemTable')) &#123
        $('#systemTable').DataTable().destroy();
    &#125

    // Initialize the DataTable on #systemTable with the provided data
    $('#systemTable').DataTable(&#123
        responsive: true,  // Makes the table responsive on different screen sizes
        data: data,        // The array of user records to display

        // Define the columns to show in the table
        columns: [
            &#123 data: "fname" &#125,  // First Name column
            &#123 data: "mname" &#125,  // Middle Name column
            &#123 data: "lname" &#125,  // Last Name column

            // Action buttons column (Edit & Delete)
            &#123
                data: null, // Access to the full row data
                render: function (data) &#123
                
                    // Return HTML for Edit and Delete buttons, embedding user data in data-* attributes
                    return `&lt;button class="edit-btn bg-blue-600 text-white px-3 py-1 rounded" 
                                data-id="$&#123data.id&#125" 
                                data-fname="$&#123data.fname&#125" 
                                data-mname="$&#123data.mname&#125" 
                                data-lname="$&#123data.lname&#125"&lgt;
                                Edit
                            &lt;/button&gt;
                            &lt;button class="delete-btn bg-red-600 text-white px-3 py-1 rounded" 
                                data-id="$&#123data.id&#125"&gt;
                                Delete
                            &lt;/button&gt;`;
                &#125
            &#125
        ]
    &#125);
&#125;

