      <!-- saveUser Function Section -->
      <div class="mt-16">
        <h1 class="font-bold text-2xl border-b-4 w-fit pr-3 mt-3">saveUser</h1>
        <p>
          The purpose of the saveUser function is to handle the process of
          submitting new user data from a form to the server and then update the
          webpage accordingly.
        </p>
        <div
          class="bg-[#23272e] text-[#f8f8f2] p-4 rounded-md mt-4 overflow-x-auto max-w-full"
